#
# Makefile for building rogue 4.22 with gcc or clang on Linux
#
# CFLAGS may be replaced, with a distribution's own flags for one.
# REQUIRED comes after it, so that nothing in CFLAGS undoes it, and
# lets the compiler build the 1982 source as it stands:
#
#   -std=gnu89
#	The source is C from before the 1989 standard: old-style
#	function definitions, functions called without being declared
#	and types left to default to int.  Later standards do not
#	allow these.
#   -w
#	Silence the warnings that style draws.
#   -fno-common
#	Keep each file's variables together in that file's own data.
#	Older compilers otherwise leave the ones with no initial
#	value for the linker to place, apart from the rest, and a
#	saved game takes the game's data to lie between its first
#	file and its last.
#   -fsigned-char
#	The source keeps small numbers in a char, the two halves of
#	a direction among them, and takes it that a char can be
#	negative, as it could on a VAX.  On ARM and several other
#	machines it cannot unless the compiler is told.
#   -fwrapv
#	The random number generator multiplies its seed and lets the
#	result overflow.  gcc otherwise assumes that signed arithmetic
#	never overflows.
#   -fno-strict-aliasing
#	At -O2 gcc assumes that pointers to different types never
#	point at the same storage.  The source was written before
#	that rule; options.c, for one, keeps pointers to its char
#	options as pointers to int.
#   -fno-lto
#	Restoring a saved game reads it back over the game's
#	variables.  Compiling a file at a time gcc cannot tell, but
#	optimizing the whole program at once it can go on using
#	values that the restore has replaced.  It is left out when
#	linking, where NetBSD's gcc hands it on to the linker.
#   -D_FILE_OFFSET_BITS=64
#	On a 32-bit system, have stat() report 64-bit inode numbers
#	and sizes.  It otherwise fails for a file whose inode number
#	does not fit in 32 bits, as on many network and large file
#	systems, and the game can neither restore a game saved there
#	nor keep its scores there.  It changes nothing on a 64-bit
#	system.
#
# gcc and clang do not take all the same flags, and not every version
# of either takes them all, so each of these is used only if $(CC)
# accepts it:
#
#   -Wno-error=return-type
#	Functions with no declared type return without a value,
#	which clang makes an error.
#   -Wno-error=incompatible-function-pointer-types
#	Signal handlers are functions with no declared type, which
#	makes them int and not void.  clang makes that an error too.
#
# LIMITS turns off the check on the number of users that mach_dep.h
# sets up: a machine that is running many games at once, as
# Rog-O-Matic does, would otherwise turn new games away and end the
# ones being played.  Set it empty to keep it.  The check on the load
# average is already left out in mach_dep.h.
#
# SCOREFILE says where the scores are kept.  It is
# ~/.local/games/rogue4.22/scorefile unless it is given on the make
# line, and make writes $(HOME) out when it builds, as open() does
# not know ~.  Set it empty to keep no scores.  No scores are kept if
# the file is not there; 'make -f Makefile.linux install' makes it,
# empty.  Nor are they kept in anything but a plain file with one
# link.  A rogue installed set-id needs a SCOREFILE of its own, in a
# directory that only the id it runs as can write: the default is in
# the home directory of whoever built it.  Each version of rogue
# keeps its scores in a file of its own.
#
# A saved game is an image of the game's data and can only be
# restored by the same build of rogue that saved it.
#
CC=	gcc
CFLAGS=	-O2 -g
LIMITS=	-DMAXUSERS=0
SCOREFILE= $(HOME)/.local/games/rogue4.22/scorefile
SF=	-DSCOREFILE='"$(SCOREFILE)"'
REQUIRED= -std=gnu89 -w -fno-common -fsigned-char -fwrapv \
	-fno-strict-aliasing -D_FILE_OFFSET_BITS=64 \
	-fno-lto $(ACCEPTED) $(LIMITS) $(SF) $(DEFS)
accepts= $(shell $(CC) -Werror $(1) -E -x c /dev/null >/dev/null 2>&1 \
	&& echo $(1))
ACCEPTED:= $(call accepts,-Wno-error=return-type) \
	$(call accepts,-Wno-error=incompatible-function-pointer-types)
CRLIB=	-lcurses
OBJS=	vers.o armor.o chase.o command.o daemon.o daemons.o \
	extern.o fight.o init.o io.o list.o main.o misc.o \
	monsters.o move.o new_level.o options.o pack.o passages.o potions.o \
	rings.o rip.o rooms.o save.o scrolls.o sticks.o things.o \
	weapons.o wizard.o mach_dep.o alloc.o

rogue: $(OBJS)
	$(CC) $(CFLAGS) $(filter-out -fno-lto,$(REQUIRED)) $(LDFLAGS) -o rogue $(OBJS) $(CRLIB)

.c.o:
	$(CC) $(CFLAGS) $(CPPFLAGS) $(REQUIRED) -c $<

$(OBJS): rogue.h extern.h rogue.flags
mach_dep.o: mach_dep.h

#
# rogue.flags holds the compiler and the flags that the objects were
# made with, and is rewritten only when they change.  The objects depend
# on it, so that a different SCOREFILE, LIMITS or DEFS, which only change
# the flags, make rogue anew rather than leaving the old path or limits in it.
#
RGFLAGS= $(CC) $(CFLAGS) $(CPPFLAGS) $(REQUIRED)
export RGFLAGS
.PHONY: FORCE
rogue.flags: FORCE
	@printf '%s\n' "$$RGFLAGS" | cmp -s - $@ || printf '%s\n' "$$RGFLAGS" > $@

#
# 'make -f Makefile.linux install' makes the directory the score file
# goes in, and the score file itself, empty, if it is not there yet.
# Only its owner may read or write it: anyone who can open it can also
# keep it locked, and then no game can record a score.  On a rogue
# installed set-id that is every player: a game stopped while it holds
# the lock keeps it, and the other games leave their scores out.  A rogue
# installed set-gid needs the file made 0660 and given to its group.
# Run it as whoever built rogue: under sudo, $(HOME) may be root's.
# A HOME with a space or a quote in it is not handled; give a
# SCOREFILE without them.  It makes nothing through a symbolic link.
# The directories it makes can be written by their owner only, so that
# nobody else can put another file in the score file's place.
#
.PHONY: install
install:
	@test -n "$(SCOREFILE)" || { echo "SCOREFILE is not set"; exit 1; }
	@test ! -h "$(SCOREFILE)" || { echo "$(SCOREFILE) is a symbolic link"; exit 1; }
	(umask 022 && mkdir -p "$(dir $(SCOREFILE))")
	test -f "$(SCOREFILE)" || (umask 077 && : > "$(SCOREFILE)")

#
# 'make -f Makefile.linux check' builds check/rogue with the address
# sanitizer.  That rogue stops with a report on any read or write
# outside an array and on any use of freed memory.  DUMP keeps rogue
# from catching the fault signals itself.  gcc defines
# __SANITIZE_ADDRESS__ when the sanitizer is on, and save.c and
# alloc.c go by it; clang may not, so it is defined here.
#
.PHONY: check
check:
	mkdir -p check
	cd check && ln -sf ../*.c ../*.h ../Makefile.linux . && \
	$(MAKE) -f Makefile.linux rogue \
	    DEFS="-DDUMP -D__SANITIZE_ADDRESS__=1 -fsanitize=address \
	    -fno-omit-frame-pointer"

clean:
	rm -f $(OBJS) rogue rogue.flags
	rm -rf check
